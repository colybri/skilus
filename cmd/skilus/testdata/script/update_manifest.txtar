# skilus update applies skills added to or removed from skilus.yaml by hand:
# it installs the new ones in the detected agents, with what they require,
# and removes the ones gone, with the requirements nothing else needs.
[windows] skip 'HOME layout differs on Windows'
env HOME=$WORK/home
env CLAUDE_CONFIG_DIR=
env CODEX_HOME=
env XDG_CONFIG_HOME=
mkdir home/.claude project
cd project

exec skilus add ../src --skill review --agent claude-code --yes
exec skilus update
stdout 'Todo al día\.'

# Two skills added to skills:; --check and verify see them.
cp $WORK/added.yaml skilus.yaml
exec skilus update --check --scope project
stdout '^lint +project +- +- +- +nueva en skilus.yaml: \.\./src$'
stdout '^report +project .* nueva en skilus.yaml: \.\./src$'

# Answering no changes nothing.
stdin $WORK/no.txt
! exec skilus update
stdout '^Nuevas en skilus.yaml:$'
stdout '^● lint '
stdout '^● report '
stdout '^● pdf '
stdout 'Destinos: \.claude[/\\]skills'
stdout '^3 skills · 0 bloqueos · 0 avisos$'
! exists .claude/skills/lint

# Naming a skill installs only that one.
exec skilus update lint --yes
stdout '^Instalada lint \([0-9a-f]{12}\), nueva en skilus.yaml\.$'
exists .claude/skills/lint/SKILL.md
! exists .claude/skills/report

# The rest come with what they require.
exec skilus update --yes
stdout '^Instalada report \([0-9a-f]{12}\), nueva en skilus.yaml\.$'
stdout '^Instalada pdf \([0-9a-f]{12}\), que ahora se necesita\.$'
exists .claude/skills/report/SKILL.md
exists .claude/skills/pdf/SKILL.md
exec skilus verify --scope project
cmp skilus.yaml $WORK/added.yaml

# Requirements are not in skills: and are not taken as removed.
exec skilus update --check --scope project
! stdout 'quitada'
exec skilus update
stdout 'Todo al día\.'

# Removing skills from skills: removes them and their requirements.
cp $WORK/removed.yaml skilus.yaml
exec skilus update --check --scope project
stdout '^review +project .* quitada de skilus.yaml$'
stdout '^report +project .* quitada de skilus.yaml$'
exec skilus update --yes
stderr '^Retirar:$'
stderr '^- review   quitada de skilus.yaml$'
stderr '^- pdf   ya no la necesita ninguna skill$'
stdout '^Retirada review, que ya no está en skilus.yaml\.$'
stdout '^Retirada report, que ya no está en skilus.yaml\.$'
stdout '^Retirada pdf, que ya no se necesita\.$'
! exists .claude/skills/review
! exists .claude/skills/report
! exists .claude/skills/pdf
exists .claude/skills/lint/SKILL.md
! grep 'name: review' skilus.lock
exec skilus verify --scope project
exec skilus update
stdout 'Todo al día\.'

# Without skilus.yaml there is nothing to apply: the lock stays.
rm skilus.yaml
exec skilus update
stdout 'Todo al día\.'
exists .claude/skills/lint/SKILL.md

-- added.yaml --
version: 1
skills:
  - name: review
    source: ../src
  - name: lint
    source: ../src
  - name: report
    source: ../src
-- removed.yaml --
version: 1
skills:
  - name: lint
    source: ../src
-- no.txt --
n
-- src/skills/review/SKILL.md --
---
name: review
description: Revisa cambios
---
-- src/skills/lint/SKILL.md --
---
name: lint
description: Revisa el estilo
---
-- src/skills/report/SKILL.md --
---
name: report
description: Informes
metadata:
  requires: pdf
---
-- src/skills/pdf/SKILL.md --
---
name: pdf
description: PDF
---
