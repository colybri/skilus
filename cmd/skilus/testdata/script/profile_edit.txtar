# skilus profile create, add, remove and delete edit profiles: in
# skilus.yaml without touching the rest of the file.
cd project

exec skilus profile create backend --skill debug,api --agent claude-code
stdout 'Perfil backend creado\.'
stdout '^  skills: debug, api$'
stdout '^  agentes: claude-code$'
exec skilus profile create web --skill debug
stdout '^  agentes: detectados$'

! exec skilus profile create web
stderr 'ya está en skilus.yaml'
! exec skilus profile create mobile --skill nope
stderr 'la skill nope no está en skills: de skilus.yaml; añádela antes con skilus add'
! exec skilus profile create mobile --agent emacs
stderr 'agente emacs desconocido'

exec skilus profile add web ui --agent codex
stdout 'Perfil web actualizado\.'
stdout '^  skills: debug, ui$'
stdout '^  agentes: codex$'
exec skilus profile remove backend api
stdout '^  skills: debug$'
! exec skilus profile remove backend ui
stderr 'el perfil backend no incluye la skill ui'
! exec skilus profile add backend
stderr 'indica al menos una skill o un --agent'
! exec skilus profile add mobile ui
stderr 'el perfil "mobile" no está en skilus.yaml'

exec skilus profile create old
exec skilus profile delete old
stdout 'Perfil old borrado\.'
! exec skilus profile delete old
stderr 'el perfil "old" no está en skilus.yaml'
# Errors come out in the user's language, down to the error kind.
env SKILUS_LANG=en
! exec skilus profile delete old
stderr '^skilus: profile "old" is not in skilus.yaml; profiles: backend, web: not found$'
env SKILUS_LANG=es

cmp skilus.yaml $WORK/want.yaml
exec skilus profile list
stdout '^ +backend +debug +claude-code$'
stdout '^ +web +debug,ui +codex$'

-- project/skilus.yaml --
# Skills del equipo
version: 1
skills:
  - name: debug
    source: ./src # depuración
  - name: api
    source: ./src
  - name: ui
    source: ./src
-- want.yaml --
# Skills del equipo
version: 1
skills:
  - name: debug
    source: ./src # depuración
  - name: api
    source: ./src
  - name: ui
    source: ./src
profiles:
  backend:
    skills: [debug]
    agents: [claude-code]
  web:
    skills: [debug, ui]
    agents: [codex]
