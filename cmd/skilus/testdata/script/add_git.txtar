# skilus add installs from a Git repository and pins the commit.
[!exec:git] skip 'git is not installed'
[windows] skip 'HOME layout differs on Windows'
env HOME=$WORK/home
env CLAUDE_CONFIG_DIR=
env CODEX_HOME=
env XDG_CONFIG_HOME=
env GIT_AUTHOR_NAME=t
env GIT_AUTHOR_EMAIL=t@example.com
env GIT_COMMITTER_NAME=t
env GIT_COMMITTER_EMAIL=t@example.com
env GIT_CONFIG_NOSYSTEM=1
mkdir home project

cd remote
exec git init --quiet --initial-branch=main
exec git add .
exec git commit --quiet -m v1
exec git tag v1.0.0
cd $WORK/project

exec skilus add file://$WORK/remote@v1.0.0 --agent claude-code --yes
stdout 'Instalada review'
exists .claude/skills/review/SKILL.md
grep 'source: file://.*/remote$' skilus.lock
grep 'requested: v1.0.0' skilus.lock
grep 'commit: [0-9a-f]{40}' skilus.lock
grep 'source: file://.*/remote@v1.0.0' skilus.yaml

# A ref that does not exist is not found (exit code 3).
! exec skilus add file://$WORK/remote@nope --agent claude-code --yes
stderr 'not found|couldn.t find remote ref'

# Credentials never go in the source.
! exec skilus add https://me:token@github.com/o/r --agent claude-code --yes
stderr 'never stores tokens'

# A bare word is neither a folder nor a repository.
! exec skilus add skills --agent claude-code --yes
stderr 'start it with \./'

-- remote/skills/review/SKILL.md --
---
name: review
description: Revisa cambios
---
# Review
