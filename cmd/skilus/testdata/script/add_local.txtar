# skilus add installs skills from a local directory after inspecting them.
env HOME=$WORK/home
env USERPROFILE=$WORK/home
env CLAUDE_CONFIG_DIR=
env CODEX_HOME=
env XDG_CONFIG_HOME=
mkdir home/.claude
cd project

# Answering no changes nothing.
stdin no.txt
! exec skilus add ../src --agent claude-code
stdout '^.*src · 1 skill$'
stdout '● review   2 ficheros · [0-9]+ B · sha256 [0-9a-f]{12}'
stdout '^Destinos: .*\.claude[/\\]skills \(claude-code, copy\)$'
stdout '^1 skill · 0 bloqueos · 0 avisos$'
stdout 'Revisa cambios'
stdout '¿Instalar\? \[s/N\]'
stderr 'cancelado'
! exists .claude/skills/review
! exists skilus.lock

# Answering yes installs a copy and records it.
stdin yes.txt
exec skilus add ../src --agent claude-code
stdout 'Instalada review \([0-9a-f]{12}\) en 1 destino\.'
exists .claude/skills/review/SKILL.md
exists .claude/skills/review/guide/checklist.md
grep '^  review:$' skilus.lock
grep 'tree_sha256: [0-9a-f]{64}' skilus.lock
grep 'mode: copy' skilus.lock
grep '^  - name: review$' skilus.yaml
grep 'source: .*src' skilus.yaml

# Installing it again is a conflict (exit code 4).
! exec skilus add ../src --agent claude-code --yes
stderr 'ya está instalada'

# Blocking findings stop the install without asking (exit code 5).
# Creating symlinks on Windows needs privileges the runner may lack.
[!windows] symlink ../evil/leak -> ../secret
[!windows] ! exec skilus add ../evil --agent claude-code
[!windows] stderr '✗ leak: apunta a \.\./secret.* \[symlink-escape\]'
[!windows] stderr '1 skill · 1 bloqueo · 0 avisos'
[!windows] stderr 'rechazado por la inspección'
! exists .claude/skills/evil

# Scripts need --allow-scripts under --yes.
# Windows has no executable bit, so no file counts as a script there.
chmod 755 ../tools/lint.sh
[!windows] ! exec skilus add ../tools --agent claude-code --yes
[!windows] stderr 'los ficheros ejecutables necesitan --allow-scripts'
exec skilus add ../tools --agent claude-code --yes --allow-scripts
[!windows] grep 'allow: \[scripts\]' skilus.yaml

# Global scope links to the store by default, except on Windows, where
# symlinks need privileges.
exec skilus add ../src --scope global --agent claude-code --yes
exists $HOME/.skilus/skilus.lock
[!windows] grep 'mode: symlink' $HOME/.skilus/skilus.lock
[windows] grep 'mode: copy' $HOME/.skilus/skilus.lock

# Missing sources are not found (exit code 3).
! exec skilus add ../nope --agent claude-code --yes
stderr 'no existe'

-- project/no.txt --
n
-- project/yes.txt --
s
-- src/skills/review/SKILL.md --
---
name: review
description: Revisa cambios antes de un commit
---
# Review
-- src/skills/review/guide/checklist.md --
- Tests verdes
-- evil/SKILL.md --
---
name: evil
description: Parece inofensiva
---
-- tools/SKILL.md --
---
name: lint
description: Lanza el linter
---
-- tools/lint.sh --
#!/bin/sh
echo lint
